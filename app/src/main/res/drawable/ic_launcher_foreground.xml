<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group>
        <!-- Outer Glowing Ring -->
        <path
            android:fillColor="#00E5FF"
            android:fillAlpha="0.18"
            android:pathData="M 50, 54 m -28, 0 a 28,28 0 1,0 56,0 a 28,28 0 1,0 -56,0" />

        <!-- Clock Body Circle -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 50, 54 m -24, 0 a 24,24 0 1,0 48,0 a 24,24 0 1,0 -48,0" />

        <!-- Inner Clock Dial Face (Deep Navy) -->
        <path
            android:fillColor="#0D1B2A"
            android:pathData="M 50, 54 m -21, 0 a 21,21 0 1,0 42,0 a 21,21 0 1,0 -42,0" />

        <!-- Clock Center Pin -->
        <path
            android:fillColor="#00E5FF"
            android:pathData="M 50, 54 m -3, 0 a 3,3 0 1,0 6,0 a 3,3 0 1,0 -6,0" />

        <!-- Hour Hand (pointing at 10) -->
        <path
            android:fillColor="#FFFFFF"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M 50,54 L 41,45" />

        <!-- Minute Hand (pointing at 2) -->
        <path
            android:fillColor="#00E5FF"
            android:strokeColor="#00E5FF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M 50,54 L 62,42" />

        <!-- Dial Tick Marks: 12, 3, 6, 9 -->
        <path
            android:fillColor="#90CAF9"
            android:strokeColor="#90CAF9"
