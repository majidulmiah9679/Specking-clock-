            android:strokeLineCap="round"
            android:pathData="M 50,36 L 50,39 M 68,54 L 65,54 M 50,72 L 50,69 M 32,54 L 35,54" />

        <!-- Speaking Waves on the Right Side -->
        <!-- Small wave -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#00E5FF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M 77,47 C 80,51 80,57 77,61" />

        <!-- Medium wave -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#00E5FF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M 82,42 C 87,48 87,60 82,66" />

        <!-- Large wave -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#80D8FF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M 87,37 C 94,46 94,62 87,71" />
